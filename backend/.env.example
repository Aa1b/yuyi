# 复制为 .env 后按需修改（不要提交真实密钥到仓库）

PORT=3000
JWT_SECRET=your_jwt_secret_key

# 经反向代理部署时设为 1，否则限流按「单一 IP」计数易误伤所有人
# TRUST_PROXY=1

# 全局限流：RATE_LIMIT_ENABLED=false 可关闭；RATE_LIMIT_MAX 默认 800 / 每窗口（见 RATE_LIMIT_WINDOW_MS）
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_MAX=800
# RATE_LIMIT_WINDOW_MS=900000

# 上传文件对外访问的完整 URL 前缀（须 HTTPS，且与小程序「downloadFile 合法域名」一致，不要以 / 结尾）
# 本地开发可设为：http://localhost:3000
STORAGE_BASE_URL=https://api.zaoqidawang.xin
