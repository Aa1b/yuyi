<t-navbar title="生活记录详情" left-arrow placeholder />
<view class="life-detail-container">
  <view wx:if="{{loading}}" class="life-detail-loading">
    <t-loading theme="circular" size="40rpx" text="加载中..." />
  </view>

  <view wx:else class="life-detail-content">
    <!-- 用户信息和内容 -->
    <view class="life-detail-record">
      <!-- 用户信息 -->
      <view class="life-detail-header">
        <t-avatar image="{{record.avatar || defaultAvatarUrl}}" size="medium" catchtap="goToUserProfile" data-user-id="{{record.userId}}" />
        <view class="life-detail-user-info" catchtap="goToUserProfile" data-user-id="{{record.userId}}">
          <text class="life-detail-username">{{record.userName}}</text>
          <text class="life-detail-time">{{record.displayTime}}</text>
        </view>
        <view class="life-detail-privacy">
          <t-icon
            name="{{record.privacy === 'public' ? 'globe' : record.privacy === 'friends' ? 'user' : 'lock-on'}}"
            size="32rpx"
            color="#999"
          />
          <text class="life-detail-privacy-text">{{record.privacyLabel}}</text>
        </view>
      </view>

      <!-- 内容 -->
      <view class="life-detail-body">
        <text wx:if="{{record.title}}" class="life-detail-title">{{record.title}}</text>
        <text wx:if="{{record.content}}" class="life-detail-text">{{record.content}}</text>

        <!-- 图片展示（全部照片） -->
        <view wx:if="{{record.type === 'image' && record.images && record.images.length > 0}}" class="life-detail-media">
          <view class="life-detail-images">
            <t-image
              wx:for="{{record.images}}"
              wx:key="index"
              wx:for-item="img"
              data-index="{{index}}"
              src="{{img}}"
              mode="aspectFill"
              class="life-detail-image {{record.images.length === 1 ? 'life-detail-image--single' : ''}}"
              bindtap="previewImage"
            />
          </view>
        </view>

        <!-- 视频展示 -->
        <view wx:if="{{record.type === 'video' && record.video}}" class="life-detail-media">
          <video
            id="life-detail-video"
            src="{{record.video.url}}"
            poster="{{record.video.cover}}"
            object-fit="contain"
            controls
            enable-progress-gesture="true"
            show-center-play-btn="true"
            class="life-detail-video"
          />
        </view>

        <!-- 位置信息 -->
        <view wx:if="{{record.location}}" class="life-detail-location">
          <t-icon name="location" size="32rpx" color="#999" />
          <text>{{record.location}}</text>
        </view>

        <!-- 分类和标签 -->
        <view class="life-detail-meta">
          <t-tag wx:if="{{record.category}}" size="small" variant="light" theme="primary">{{record.category}}</t-tag>
          <t-tag
            wx:for="{{record.tags}}"
            wx:key="index"
            wx:for-item="tag"
            size="small"
            variant="light"
            theme="success"
            class="life-detail-tag"
          >
            #{{tag}}
          </t-tag>
        </view>
      </view>

      <!-- 互动统计 -->
      <view class="life-detail-stats">
        <text>{{record.likeCount || 0}} 个赞</text>
        <text>{{record.commentCount || 0}} 条评论</text>
      </view>
    </view>

    <!-- 评论列表（楼中楼） -->
    <view class="life-detail-comments">
      <view class="life-detail-comments-title">评论 ({{commentTotal}})</view>
      <view wx:if="{{comments.length === 0}}" class="life-detail-comments-empty">
        <t-empty icon="chat" description="暂无评论" />
      </view>
      <view wx:else class="life-detail-comments-list">
        <view wx:for="{{comments}}" wx:key="id" wx:for-item="comment" id="comment-{{comment.id}}" class="life-detail-comment-block">
          <view class="life-detail-comment">
            <t-avatar
              image="{{comment.avatar || defaultAvatarUrl}}"
              size="small"
              catchtap="goToUserProfile"
              data-user-id="{{comment.userId}}"
            />
            <view class="life-detail-comment-content">
              <view class="life-detail-comment-header">
                <text
                  class="life-detail-comment-username"
                  catchtap="goToUserProfile"
                  data-user-id="{{comment.userId}}"
                >{{comment.userName}}</text>
                <text class="life-detail-comment-time">{{comment.displayTime}}</text>
                <text class="life-detail-comment-reply-btn" data-id="{{comment.id}}" data-name="{{comment.userName}}" bindtap="onReplyTap">回复</text>
              </view>
              <text class="life-detail-comment-text">{{comment.content}}</text>
            </view>
          </view>
          <view wx:if="{{comment.replies && comment.replies.length}}" class="life-detail-replies">
            <view wx:for="{{comment.replies}}" wx:key="id" wx:for-item="reply" id="comment-{{reply.id}}" class="life-detail-reply">
              <t-avatar
                image="{{reply.avatar || defaultAvatarUrl}}"
                size="small"
                catchtap="goToUserProfile"
                data-user-id="{{reply.userId}}"
              />
              <view class="life-detail-reply-main">
                <view class="life-detail-reply-meta">
                  <text
                    class="life-detail-reply-author"
                    catchtap="goToUserProfile"
                    data-user-id="{{reply.userId}}"
                  >{{reply.userName}}</text>
                  <text class="life-detail-reply-label"> 回复 {{reply.replyToUserName}}：</text>
                </view>
                <text class="life-detail-reply-text">{{reply.content}}</text>
                <text class="life-detail-reply-time">{{reply.displayTime}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 底部操作栏：用 catchtap 避免被上层拦截 -->
  <view class="life-detail-actions">
    <view class="life-detail-action-item" catchtap="handleLike">
      <t-icon
        name="{{record.isLiked ? 'heart-filled' : 'heart'}}"
        size="48rpx"
        color="{{record.isLiked ? '#ff4d4f' : '#666'}}"
      />
      <text class="{{record.isLiked ? 'life-detail-action-text--active' : ''}}">点赞</text>
    </view>
    <view class="life-detail-action-item" catchtap="showCommentInput">
      <t-icon name="chat" size="48rpx" color="#666" />
      <text>评论</text>
    </view>
  </view>
</view>

<!-- 评论输入框：用原生 textarea 避免 TDesign 在 popup 内 value 不同步 -->
<t-popup visible="{{showCommentInput}}" placement="bottom" bind:visible-change="onCommentPopupChange">
  <view class="life-detail-comment-input">
    <textarea
      class="life-detail-comment-textarea"
      placeholder="{{replyingTo ? '回复 ' + replyingTo.userName + '...' : '输入评论...'}}"
      maxlength="200"
      value="{{commentContent}}"
      bindinput="onCommentInput"
      focus="{{showCommentInput}}"
      auto-height
    />
    <view class="life-detail-comment-buttons">
      <view class="life-detail-comment-btn" catchtap="hideCommentInput">取消</view>
      <view class="life-detail-comment-btn life-detail-comment-btn--primary" catchtap="submitComment">发送</view>
    </view>
  </view>
</t-popup>

<t-message id="t-message" />
