<t-navbar title="编辑生活记录" left-arrow />
<view class="life-edit-container">
  <view wx:if="{{loading}}" class="life-edit-loading">
    <t-loading theme="circular" size="40rpx" text="加载中..." />
  </view>

  <view wx:else class="life-edit-content">
    <!-- 内容描述 -->
    <view class="desc box">
      <view class="desc-label">添加描述</view>
      <t-textarea
        t-class="desc-class"
        placeholder="分享你此刻的想法..."
        maxlength="500"
        value="{{content}}"
        bind:input="onContentInput"
        disableDefaultPadding="{{true}}"
        indicator
      />
    </view>

    <!-- 图片：与发布页一致，可增删（保存时提交完整列表） -->
    <view wx:if="{{mediaType === 'image'}}" class="upload box">
      <t-upload
        t-class="upload-class"
        media-type="{{['image']}}"
        files="{{imageFiles}}"
        gridConfig="{{imageGridConfig}}"
        bind:success="handleImageSuccess"
        bind:remove="handleImageRemove"
        max="{{imageConfig.count}}"
      />
      <view class="upload-tip">最多 9 张，可删除或继续添加</view>
    </view>

    <!-- 视频：可更换 -->
    <view wx:if="{{mediaType === 'video'}}" class="upload box">
      <t-upload
        t-class="upload-class"
        media-type="{{['video']}}"
        files="{{videoFile ? [videoFile] : []}}"
        bind:success="handleVideoSuccess"
        bind:remove="handleVideoRemove"
        max="1"
      />
      <view class="upload-tip">删除后可重新选择视频并保存</view>
    </view>

    <!-- 隐私设置 -->
    <view class="privacy box life-edit-block">
      <view class="life-edit-block__title">隐私设置</view>
      <t-radio-group value="{{privacy}}" bind:change="onPrivacyChange" class="life-edit-privacy-group">
        <view class="life-edit-privacy-inner">
          <t-radio
            wx:for="{{privacyOptions}}"
            wx:key="value"
            value="{{item.value}}"
            label="{{item.label}}"
          />
        </view>
      </t-radio-group>
      <view class="life-edit-privacy-hint">{{privacyHint}}</view>
    </view>

    <!-- 分类选择 -->
    <view class="category box">
      <t-cell
        title="分类"
        arrow
        hover
        note="{{category ? category : '请选择分类'}}"
        bind:click="showCategoryPicker"
      />
      <t-picker
        title="选择分类"
        value="{{categoryIndex}}"
        visible="{{categoryVisible}}"
        bind:change="onCategoryChange"
        bind:cancel="hideCategoryPicker"
        bind:close="hideCategoryPicker"
      >
        <t-picker-item options="{{categories}}" />
      </t-picker>
    </view>

    <!-- 标签选择（与发布页一致：chip 高亮，选中态清晰） -->
    <view class="taggroup box">
      <view class="taggroup-header">
        <text class="taggroup-title">添加标签</text>
        <text class="taggroup-count">已选 {{selectedTags.length}}/5</text>
      </view>
      <view class="taggroup-hint">点击下方标签选中（高亮）；再次点击可取消</view>
      <view class="tag-selected-row" wx:if="{{selectedTags.length > 0}}">
        <view
          wx:for="{{selectedTags}}"
          wx:key="*this"
          wx:for-item="t"
          class="tag-selected-item"
        >
          <text>#{{t}}</text>
          <text class="tag-selected-item-remove" data-tag="{{t}}" catchtap="onRemoveTag">×</text>
        </view>
      </view>
      <view class="tag-list">
        <view
          wx:for="{{allTags}}"
          wx:key="*this"
          wx:for-item="tag"
          class="tag-chip {{selectedTags.indexOf(tag) > -1 ? 'tag-chip--selected' : ''}}"
          data-tag="{{tag}}"
          bindtap="onTagTap"
        >#{{tag}}</view>
      </view>
    </view>

    <!-- 位置：地图选点 + 与个人信息相同的手动省/市（兜底） -->
    <view class="location box">
      <view class="location-tip">优先从地图选点；若不用地图，可选手动省/市（与「我的-编辑资料-地址」一致）。保存内容需含城市名，「同城」才能匹配。</view>
      <t-cell
        title="地图选点"
        hover
        arrow
        leftIcon="location"
        note="{{mapLocationNote || '点击从地图选择（推荐）'}}"
        bind:click="onLocationTap"
      />
      <t-cell
        title="选择城市"
        hover
        arrow
        note="{{manualCityLabel || '地图不可用时，在此选省/市'}}"
        bind:click="showCityPicker"
      />
      <t-picker
        mode="address"
        title="选择省、市"
        value="{{cityPickValue}}"
        visible="{{cityPickVisible}}"
        cancelBtn="取消"
        confirmBtn="确定"
        bind:cancel="hideCityPicker"
        bind:change="onCityPickChange"
        bind:close="hideCityPicker"
        bind:pick="onCityPickColumnChange"
      >
        <t-picker-item options="{{provinces}}" />
        <t-picker-item options="{{cities}}" />
      </t-picker>
      <view wx:if="{{location}}" class="location-footer">
        <text class="location-summary">当前保存：{{location}}</text>
        <text class="location-clear" catchtap="onClearLocation">清除</text>
      </view>
    </view>

    <!-- 操作按钮 -->
    <view class="btngroup box">
      <t-button
        t-class="btn-class"
        theme="primary"
        icon="check"
        content="保存"
        size="large"
        bindtap="updateRecord"
      />
    </view>
  </view>
</view>

<t-message id="t-message" />
