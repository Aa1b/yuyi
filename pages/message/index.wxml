<nav nav-type="title" title-text="消息通知" />
<view class="message-container">
  <!-- 类型筛选 -->
  <view class="message-filters">
    <t-tabs value="{{selectedType}}" bind:change="onTypeChange">
      <t-tab-panel label="全部" value="all" />
      <t-tab-panel label="点赞" value="like" />
      <t-tab-panel label="评论" value="comment" />
      <t-tab-panel label="关注" value="follow" />
      <t-tab-panel label="留言" value="guestbook" />
    </t-tabs>
  </view>

  <!-- 操作栏（仅通知 Tab 显示） -->
  <view class="message-actions" wx:if="{{unreadCount > 0 && selectedType !== 'guestbook'}}">
    <t-button theme="light" size="small" bindtap="markAllAsRead">
      全部已读
    </t-button>
  </view>

  <!-- 留言 Tab：会话列表 -->
  <view class="message-list" wx:if="{{selectedType === 'guestbook'}}">
    <view wx:if="{{needLogin}}" class="message-empty">
      <t-empty icon="chat" description="请先登录后查看留言" />
      <view class="message-login-hint">
        <t-button theme="primary" size="medium" bindtap="goToLogin">去登录</t-button>
      </view>
    </view>
    <view wx:elif="{{loadingGuestbook}}" class="message-empty">
      <t-loading theme="circular" size="40rpx" text="加载中..." />
    </view>
    <view wx:elif="{{guestbookList.length === 0}}" class="message-empty">
      <t-empty icon="chat" description="暂无留言，去个人主页给TA留言吧" />
    </view>
    <view wx:else class="guestbook-list">
      <view
        wx:for="{{guestbookList}}"
        wx:key="userId"
        class="guestbook-item"
        data-user-id="{{item.userId}}"
        data-name="{{item.userName}}"
        data-avatar="{{item.userAvatar}}"
        bindtap="onGuestbookConversationTap"
      >
        <t-avatar image="{{item.userAvatar}}" size="medium" />
        <view class="guestbook-info">
          <view class="guestbook-name-row">
            <text class="guestbook-name">{{item.userName}}</text>
            <text class="guestbook-time">{{item.displayTime}}</text>
          </view>
          <text class="guestbook-preview">{{item.lastContent}}</text>
        </view>
        <view wx:if="{{item.unreadCount > 0}}" class="guestbook-unread">{{item.unreadCount}}</view>
      </view>
    </view>
  </view>

  <!-- 通知列表（全部/点赞/评论/关注） -->
  <view class="message-list" wx:else>
    <view wx:if="{{needLogin}}" class="message-empty">
      <t-empty
        icon="notification"
        description="请先登录后查看消息"
      />
      <view class="message-login-hint">
        <t-button theme="primary" size="medium" bindtap="goToLogin">去登录</t-button>
      </view>
    </view>
    <view wx:elif="{{notifications.length === 0 && !loading}}" class="message-empty">
      <t-empty
        icon="notification"
        description="暂无通知"
      />
    </view>

    <view wx:else class="notification-list">
      <view
        wx:for="{{notifications}}"
        wx:key="id"
        wx:for-item="notification"
        class="notification-item {{notification.isRead ? '' : 'notification-item--unread'}}"
        bindtap="goToDetail"
        data-record-id="{{notification.recordId}}"
        data-comment-id="{{notification.commentId}}"
        data-from-user-id="{{notification.fromUserId}}"
      >
        <view class="notification-content">
          <t-avatar
            image="{{notification.fromUserAvatar}}"
            size="small"
            catchtap="goToUserProfile"
            data-user-id="{{notification.fromUserId}}"
          />
          <view class="notification-info">
            <view class="notification-header">
              <text class="notification-user" catchtap="goToUserProfile" data-user-id="{{notification.fromUserId}}">
                {{notification.fromUserName}}
              </text>
              <text class="notification-type">
                <t-icon
                  name="{{notification.type === 'like' ? 'heart' : notification.type === 'comment' ? 'chat' : 'user'}}"
                  size="24rpx"
                  color="#999"
                />
                {{notification.type === 'like' ? '点赞' : notification.type === 'comment' ? '评论' : '关注'}}了你
              </text>
            </view>
            <text class="notification-text">{{notification.content}}</text>
            <text class="notification-time">{{notification.displayTime || notification.createdAt}}</text>
          </view>
        </view>
        <view class="notification-actions">
          <view
            wx:if="{{!notification.isRead}}"
            class="notification-mark-read"
            data-id="{{notification.id}}"
            catchtap="markAsRead"
          >
            <t-icon name="check" size="32rpx" color="#999" />
          </view>
          <view
            class="notification-delete"
            data-id="{{notification.id}}"
            catchtap="deleteNotification"
          >
            <t-icon name="close" size="32rpx" color="#999" />
          </view>
        </view>
      </view>
    </view>
    
    <!-- 加载更多 -->
    <view wx:if="{{loading}}" class="message-loading">
      <t-loading theme="circular" size="32rpx" text="加载中..." />
    </view>
    <view wx:if="{{!hasMore && notifications.length > 0}}" class="message-no-more">
      <text>没有更多了</text>
    </view>
  </view>
</view>

<t-message id="t-message" />
