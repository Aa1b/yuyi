<t-navbar title="设置" left-arrow placeholder />
<view class="setting">
  <view class="setting-group-title">发布</view>
  <t-cell-group theme="card" t-class="cell-group-class">
    <t-cell
      title="新记录默认隐私"
      note="{{defaultPrivacyLabel}}"
      hover
      bindtap="onPrivacyTap"
      arrow
    />
  </t-cell-group>

  <view class="setting-group-title">账号与安全</view>
  <t-cell-group theme="card" t-class="cell-group-class">
    <t-cell title="修改密码" hover bindtap="onChangePassword" arrow />
  </t-cell-group>

  <view class="setting-group-title">存储</view>
  <t-cell-group theme="card" t-class="cell-group-class">
    <t-cell
      title="清除缓存"
      note="保留登录态删除临时数据"
      hover
      bindtap="onClearCache"
      arrow
    />
  </t-cell-group>

  <view class="setting-group-title">协议与关于</view>
  <t-cell-group theme="card" t-class="cell-group-class">
    <t-cell title="用户协议" hover bindtap="onUserAgreement" arrow />
    <t-cell title="隐私政策" hover bindtap="onPrivacyPolicy" arrow />
    <t-cell title="关于我们" hover bindtap="onAbout" arrow />
  </t-cell-group>
</view>

<t-toast id="t-toast" />
