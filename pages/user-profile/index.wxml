<t-navbar title="个人主页" left-arrow />
<view class="user-profile-container">
  <view wx:if="{{loading && !userInfo}}" class="user-profile-loading">
    <t-loading theme="circular" size="40rpx" text="加载中..." />
  </view>

  <view wx:else class="user-profile-content">
    <!-- 用户信息卡片 -->
    <view class="user-profile-header">
      <t-avatar image="{{userInfo.avatar}}" size="large" />
      <view class="user-profile-info">
        <text class="user-profile-name">{{userInfo.nickname}}</text>
        <view
          class="user-profile-meta-tags"
          wx:if="{{userInfo.displayZodiac || userInfo.displayHomeCity || userInfo.cityFromIp}}"
        >
          <t-tag wx:if="{{userInfo.displayZodiac}}" variant="light" size="small" icon="star">
            星座 {{userInfo.displayZodiac}}
          </t-tag>
          <t-tag wx:if="{{userInfo.displayHomeCity}}" variant="light" size="small" icon="location">
            所在地 {{userInfo.displayHomeCity}}
          </t-tag>
          <t-tag wx:if="{{userInfo.cityFromIp}}" variant="light" size="small" icon="wifi">
            IP归属 {{userInfo.cityFromIp}}
          </t-tag>
        </view>
        <view class="user-profile-stats">
          <view class="stat-item" bindtap="viewRecords">
            <text class="stat-value">{{userInfo.recordCount || 0}}</text>
            <text class="stat-label">记录</text>
          </view>
          <view class="stat-item" bindtap="viewFollowing">
            <text class="stat-value">{{userInfo.followingCount || 0}}</text>
            <text class="stat-label">关注</text>
          </view>
          <view class="stat-item" bindtap="viewFollowers">
            <text class="stat-value">{{userInfo.followerCount || 0}}</text>
            <text class="stat-label">粉丝</text>
          </view>
          <view class="stat-item">
            <text class="stat-value">{{userInfo.likeCount || 0}}</text>
            <text class="stat-label">获赞</text>
          </view>
        </view>
      </view>
      <!-- 关注区域：他人显示关注/已关注+留言，自己显示已关注 -->
      <view class="user-profile-actions">
        <t-button
          wx:if="{{isSelf}}"
          theme="light"
          size="small"
          variant="outline"
          disabled
        >
          已关注
        </t-button>
        <block wx:else>
          <t-button
            wx:if="{{isFollowing}}"
            theme="light"
            size="small"
            variant="outline"
            bindtap="toggleFollow"
          >
            已关注
          </t-button>
          <t-button
            wx:else
            theme="primary"
            size="small"
            bindtap="toggleFollow"
          >
            关注
          </t-button>
          <t-button
            class="user-profile-guestbook-btn"
            theme="light"
            size="small"
            variant="outline"
            bindtap="goGuestbook"
          >
            留言
          </t-button>
        </block>
      </view>
    </view>

    <!-- 并列两个 Tab：本人「我的记录|我赞过的」，他人「他的记录|他赞过的」 -->
    <view class="user-profile-tabs">
      <view
        class="tab-item {{activeTab === 'records' ? 'tab-item--active' : ''}}"
        data-tab="records"
        bindtap="onTabChange"
      >{{isSelf ? '我的记录' : '他的记录'}}</view>
      <view
        class="tab-item {{activeTab === 'liked' ? 'tab-item--active' : ''}}"
        data-tab="liked"
        bindtap="onTabChange"
      >{{isSelf ? '我赞过的' : '他赞过的'}}</view>
    </view>

    <!-- 记录列表（Tab 为 records） -->
    <view class="user-profile-records" wx:if="{{activeTab === 'records'}}">
      <view wx:if="{{records.length === 0 && !loading}}" class="records-empty">
        <t-empty
          icon="file-image"
          description="还没有发布任何记录"
        />
      </view>
      <view wx:else class="records-list">
        <life-record-card
          wx:for="{{records}}"
          wx:key="id"
          record="{{item}}"
          preview="{{true}}"
          bindtap="viewDetail"
        />
      </view>
      <view wx:if="{{loading}}" class="records-loading">
        <t-loading theme="circular" size="32rpx" text="加载中..." />
      </view>
      <view wx:if="{{!hasMore && records.length > 0}}" class="records-no-more">
        <text>没有更多了</text>
      </view>
    </view>

    <!-- 赞过的列表（Tab 为 liked） -->
    <view class="user-profile-records" wx:if="{{activeTab === 'liked'}}">
      <view wx:if="{{likedRecords.length === 0 && !loadingLiked}}" class="records-empty">
        <t-empty
          icon="heart"
          description="{{isSelf ? '还没有点赞过任何记录' : 'TA 还没有点赞过任何记录'}}"
        />
      </view>
      <view wx:else class="records-list">
        <life-record-card
          wx:for="{{likedRecords}}"
          wx:key="id"
          record="{{item}}"
          preview="{{true}}"
          bindtap="viewDetail"
        />
      </view>
      <view wx:if="{{loadingLiked}}" class="records-loading">
        <t-loading theme="circular" size="32rpx" text="加载中..." />
      </view>
      <view wx:if="{{!hasMoreLiked && likedRecords.length > 0}}" class="records-no-more">
        <text>没有更多了</text>
      </view>
    </view>
  </view>
</view>

<t-message id="t-message" />
